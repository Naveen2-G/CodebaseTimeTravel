# Codebase Time Traveler Environment Variables Example
# Copy this file to .env and fill in your keys.

# GitHub Personal Access Token (for authenticated GitHub API calls: 5000 req/hr limit)
GITHUB_TOKEN=your_github_token_here

# Gemini API Key for server-side AI Code Explanation (Phase 5)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key for server-side AI Evidence Verification (Phase 5.5)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key for server-side AI Fallback Analysis and Verification (Phase 7D)
GROQ_API_KEY=your_groq_api_key_here


